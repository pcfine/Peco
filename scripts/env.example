# peco 环境变量模板
# 复制此文件为 .env，填入实际值后运行 scripts/deploy.sh
#   cp scripts/env.example .env
#   sudo bash scripts/deploy.sh

# ============================================
# 必填
# ============================================

# DeepSeek API 密钥 — 用于大模型调用
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# ============================================
# 推荐设置
# ============================================

# JWT 签名密钥 — 用于用户认证 Token 签发
# 不设置则在部署时自动生成 (openssl rand -hex 32)
# 生产环境推荐手动设置，确保升级/重启后 Token 不失效
PECO_JWT_SECRET=

# ============================================
# 后端运行配置
# ============================================

# 绑定地址和端口 (默认 127.0.0.1:9227，仅本地访问)
# 如果通过 Nginx 代理，保持 127.0.0.1 即可
PECO_SERVER_HOST=127.0.0.1
PECO_SERVER_PORT=9227

# 数据目录（SQLite 数据库、会话文件、知识库索引）
DATA_DIR=/var/lib/peco

# SQLite 数据库连接串
# PECO_DATABASE_URL=sqlite:/var/lib/peco/server.db?mode=rwc

# 日志级别 (可选: trace, debug, info, warn, error)
# RUST_LOG=peco=info,tower_http=warn

# ============================================
# 安装路径
# ============================================

# 后端二进制安装路径
INSTALL_BIN=/usr/local/bin/peco-server

# 前端静态文件目录
WEB_ROOT=/var/www/peco-webui

# ============================================
# systemd 配置
# ============================================

# 后端运行用户和组 (默认 www-data)
SYSTEMD_USER=www-data
SYSTEMD_GROUP=www-data

# ============================================
# Nginx 配置
# ============================================

# Nginx server_name (默认 _ 匹配所有)
NGINX_SERVER_NAME=_

# Nginx 监听端口 (默认 80)
NGINX_LISTEN=80

# ============================================
# 部署脚本选项
# ============================================

# 跳过确认提示（设为 1 跳过）
# SKIP_CONFIRM=1
